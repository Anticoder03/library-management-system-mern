# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/smart_library

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d
JWT_RESET_EXPIRE=15m

# CORS - comma separated origins, e.g. http://localhost:5173,https://app.example.com
CLIENT_URL=http://localhost:5173

# Optional: SMTP for password reset emails. If omitted, reset tokens are returned in the API response in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Smart Library <no-reply@smartlibrary.local>"

# Business rules
BORROW_LIMIT=5
LOAN_PERIOD_DAYS=14
FINE_PER_DAY=5
MAX_RESERVATIONS=3
