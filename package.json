{
  "name": "smart-library-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack MERN library management system",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "seed": "npm --prefix server run seed",
    "build": "npm --prefix client run build",
    "test": "npm --prefix server run test:integration && npm --prefix server run test:seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
